[Unit]
Description=macshell notification daemon (org.freedesktop.Notifications, X11)
PartOf=graphical-session.target
After=graphical-session.target
# Wayland sessions have their own daemon (mako, dunst); macnotify also exits quietly when the name is taken.
ConditionEnvironment=!WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/macnotify
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
