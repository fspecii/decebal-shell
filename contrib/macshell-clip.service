[Unit]
Description=macshell clipboard history daemon (X11)
PartOf=graphical-session.target
After=graphical-session.target
# X11 sessions only: macclip needs the XFixes selection events of a real X server.
ConditionEnvironment=!WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/macclip daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
