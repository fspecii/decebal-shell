[Unit]
Description=decebal hot corners daemon (X11)
PartOf=graphical-session.target
After=graphical-session.target
# X11 sessions only: the corners are X windows.
ConditionEnvironment=!WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/dechot daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
